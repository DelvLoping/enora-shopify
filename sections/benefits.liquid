<section id="bienfaits" class="py-28 lg:py-40" data-section-type="benefits" data-section-id="{{ section.id }}">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="max-w-2xl mb-16 lg:mb-24">
      <p class="reveal text-[11px] tracking-[0.4em] uppercase text-taupe mb-6">
        {{ section.settings.eyebrow | escape }}
      </p>
      <h2 class="reveal reveal-delay-1 text-4xl lg:text-6xl text-balance">
        {{ section.settings.headline }}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-px bg-border rounded-3xl overflow-hidden shadow-soft">
      {% assign benefits = section.settings.benefits | split: '||' %}
      {% for benefit in benefits %}
        {% assign parts = benefit | strip | split: '|' %}
        <div class="reveal reveal-delay-{{ forloop.index | minus: 1 }} bg-card p-10 lg:p-14 transition-colors hover:bg-card/60 relative overflow-hidden">
          <div class="absolute opacity-25 pointer-events-none" style="color:oklch(0.62 0.18 25);top:-30px;left:-30px;">
            {% if forloop.index == 1 %}
            <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" x2="9.01" y1="9" y2="9"/>
              <line x1="15" x2="15.01" y1="9" y2="9"/>
            </svg>
            {% elsif forloop.index == 2 %}
            <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 20h10"/>
              <path d="M10 20c5.5-2.5.8-6.4 3-10"/>
              <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/>
              <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>
            </svg>
            {% elsif forloop.index == 3 %}
            <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
              <path d="M20 3v4"/>
              <path d="M22 5h-4"/>
              <path d="M4 17v2"/>
              <path d="M5 18H3"/>
            </svg>
            {% else %}
            <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 11V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2"/>
              <path d="M14 10V4a2 2 0 0 0-2-2 2 2 0 0 0-2 2v2"/>
              <path d="M10 10.5V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2v8"/>
              <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
            </svg>
            {% endif %}
          </div>
          <h3 class="text-2xl lg:text-3xl mb-4 relative z-10">{% if parts[0] %}{{ parts[0] | strip }}{% endif %}</h3>
          <p class="text-muted-foreground leading-relaxed relative z-10">{% if parts[1] %}{{ parts[1] | strip }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits Grid",
  "tag": "section",
  "class": "section-benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bienfaits"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "La science, <em class='not-italic text-taupe'>discrètement.</em>"
    },
    {
      "type": "textarea",
      "id": "benefits",
      "label": "Benefits (separated by ||, title|description)",
      "default": "Cuir chevelu apais&eacute;|R&eacute;duction visible des tensions et des inconforts d&egrave;s les premi&egrave;res semaines d&rsquo;utilisation.||Cheveux renforc&eacute;s|La lumi&egrave;re rouge &agrave; 660 nm aide &agrave; stimuler les follicules pour une fibre capillaire plus dense et plus forte.||Routine simplifi&eacute;e|4 minutes par jour suffisent. Pas de produit &agrave; appliquer, pas de rendez-vous, pas de contrainte.||Technologie s&ucirc;re|132 diodes LED sans UV, sans chaleur excessive. Test&eacute; selon les normes europ&eacute;ennes les plus strictes."
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "category": "ENORA Sections"
    }
  ]
}
{% endschema %}
