<section id="faq" class="py-28 lg:py-40" style="background:oklch(0.96 0.015 78);" data-section-type="faq" data-section-id="{{ section.id }}">
  <div class="mx-auto max-w-4xl px-6 lg:px-10">
    <div class="mb-16 lg:mb-20">
      <p class="reveal text-[11px] tracking-[0.4em] uppercase text-taupe mb-6">
        {{ section.settings.eyebrow | escape }}
      </p>
      <h2 class="reveal reveal-delay-1 text-4xl lg:text-6xl text-balance">
        {{ section.settings.headline }}
      </h2>
    </div>

    <div data-faq-container>
      {% assign faq_items = section.settings.faq_items | split: '||' %}
      {% for item in faq_items %}
        {% assign parts = item | strip | split: '|' %}
        <div class="faq-item border-b border-border" data-faq-item>
          <button
            class="w-full flex items-center justify-between py-7 text-left group bg-transparent border-0 cursor-pointer"
            data-faq-toggle
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="font-display text-xl lg:text-2xl text-foreground pr-6">
              {% if parts[0] %}{{ parts[0] | strip }}{% endif %}
            </span>
            <span class="faq-plus text-2xl text-taupe transition-transform duration-500 {% if forloop.first %}rotate-45{% endif %}">
              +
            </span>
          </button>
          <div class="faq-answer grid transition-all duration-500 {% if forloop.first %}grid-rows-[1fr] pb-7{% else %}grid-rows-[0fr]{% endif %}" data-faq-answer>
            <div class="overflow-hidden">
              <p class="text-muted-foreground leading-relaxed max-w-2xl">
                {% if parts[1] %}{{ parts[1] | strip }}{% endif %}
              </p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Tout ce qu'il faut <em class='not-italic text-taupe'>savoir.</em>"
    },
    {
      "type": "textarea",
      "id": "faq_items",
      "label": "FAQ items (|| separated, question|answer)",
      "default": "&Agrave; qui s&rsquo;adresse ENORA ?|A toutes celles et ceux qui veulent prendre soin de leur cuir chevelu : femmes, hommes, tous types de cheveux.||En combien de temps voit-on des r&eacute;sultats ?|La sensation d&rsquo;apaisement est imm&eacute;diate. Les premiers r&eacute;sultats visibles apparaissent g&eacute;n&eacute;ralement entre la 4&egrave;me et la 8&egrave;me semaine d&rsquo;usage quotidien.||Combien de temps dure une s&eacute;ance ?|Quatre minutes par jour suffisent. Vous pouvez l&rsquo;int&eacute;grer &agrave; votre routine matinale ou en faire un moment de pause le soir.||L&rsquo;appareil est-il s&ucirc;r ?|ENORA utilise une lumi&egrave;re LED rouge &agrave; 660nm, sans UV, sans chaleur excessive. Test&eacute; selon les normes europ&eacute;ennes les plus strictes.||Comment nettoyer ENORA ?|Un chiffon doux l&eacute;g&egrave;rement humide suffit. La brosse se d&eacute;tache facilement pour un nettoyage complet. L&rsquo;appareil est con&ccedil;u pour durer des ann&eacute;es."
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "category": "ENORA Sections"
    }
  ]
}
{% endschema %}
