<section id="top" class="relative pt-32 pb-12 lg:pt-40 lg:pb-24 bg-warm-gradient overflow-hidden" data-section-type="hero" data-section-id="{{ section.id }}">
  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-ember-glow pointer-events-none"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="text-center max-w-4xl mx-auto">

      <p class="reveal text-[11px] tracking-[0.4em] uppercase text-taupe mb-6">
        {{ section.settings.eyebrow | escape }}
      </p>

      <h1 class="reveal reveal-delay-1 text-[44px] sm:text-6xl lg:text-[88px] text-balance text-foreground">
        {{ section.settings.headline }}
      </h1>

      <p class="reveal reveal-delay-2 mt-8 text-base lg:text-lg text-muted-foreground max-w-xl mx-auto text-balance">
        {{ section.settings.subhead | escape }}
      </p>

      <div class="reveal reveal-delay-3 mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <form method="post" action="/cart/add" class="m-0">
          <input type="hidden" name="id" value="{{ all_products['enora'].selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="rounded-full bg-foreground text-background px-8 py-4 text-sm tracking-wide hover:bg-foreground/90 transition-all hover:scale-[1.02] border-0 cursor-pointer">
            {{ section.settings.cta_primary_text }}{% if all_products['enora'].compare_at_price > all_products['enora'].price %} <span style="text-decoration:line-through;opacity:0.5;">{{ all_products['enora'].compare_at_price | money }}</span>{% endif %}
          </button>
        </form>
        <a href="#rituel" class="text-sm text-muted-foreground hover:text-foreground transition-colors px-6 py-4 no-underline">
          {{ section.settings.cta_secondary_text }}
        </a>
      </div>

      <div class="reveal reveal-delay-4 mt-10 flex items-center justify-center gap-8 text-[11px] tracking-[0.2em] uppercase text-muted-foreground">
        <span>{{ section.settings.badge_1 }}</span>
        <span class="h-1 w-1 rounded-full bg-border"></span>
        <span>{{ section.settings.badge_2 }}</span>
        <span class="h-1 w-1 rounded-full bg-border hidden sm:block"></span>
        <span class="hidden sm:inline">{{ section.settings.badge_3 }}</span>
      </div>
    </div>

    <div class="reveal reveal-delay-4 mt-16 lg:mt-24 relative">
      <div class="relative aspect-[16/10] rounded-3xl overflow-hidden shadow-soft animate-float">
        {% if section.settings.hero_image %}
          {{ section.settings.hero_image | image_url: width: 1600 | image_tag:
            loading: 'eager',
            class: 'w-full h-full object-cover',
            alt: 'Appareil ENORA à lumière rouge'
          }}
        {% else %}
          <img src="{{ 'hero-product.jpg' | asset_url }}" alt="Appareil ENORA à lumière rouge" class="w-full h-full object-cover" loading="eager" width="1600" height="1000" />
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-background/20 via-transparent to-transparent"></div>
      </div>
      <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 h-24 w-3/4 rounded-full bg-ember/20 blur-3xl animate-ember -z-10"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Edition 01 · Scalp Wellness"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "La lumière qui<br/><em class='not-italic text-taupe'>prend soin de vous.</em>"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "ENORA réinvente le soin du cuir chevelu. Un rituel quotidien à lumière rouge, conçu comme une parenthèse de calme pour des cheveux plus forts, un esprit plus clair."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA text",
      "default": "Commander · 89€"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA text",
      "default": "Découvrir le rituel →"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Trust badge 1",
      "default": "Livraison offerte"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Trust badge 2",
      "default": "Technologie LED"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Trust badge 3",
      "default": "Paiement en 4×"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero product image"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "ENORA Sections"
    }
  ]
}
{% endschema %}
