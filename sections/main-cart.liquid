{% comment %} ENORA Cart Page — Premium UX {% endcomment %}
<div class="pt-32 pb-24 min-h-screen bg-background">
  <div class="mx-auto max-w-xl lg:max-w-2xl px-4 sm:px-6">

    {% if cart.item_count > 0 %}

      <div class="mb-8 lg:mb-10">
        <h1 class="font-display text-3xl lg:text-4xl text-foreground mb-2">Votre panier</h1>
        <p class="text-sm text-muted-foreground">{{ cart.item_count }}&nbsp;article{% if cart.item_count > 1 %}s{% endif %}</p>
      </div>

      <div class="rounded-2xl bg-card border border-border/60 p-6 sm:p-8">

        {% for item in cart.items %}
        <div class="{% unless forloop.first %}mt-5 pt-5 border-t border-border/30{% endunless %}">
          <div class="flex gap-4 sm:gap-5">

            {% comment %} Image — 96x96 square {% endcomment %}
            <a href="{{ item.url }}" style="width:96px;height:96px;min-width:96px;" class="rounded-xl overflow-hidden bg-sand/20 block shrink-0">
              {% if item.image %}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: item.product.title | escape }}
              {% else %}
                <div class="w-full h-full flex items-center justify-center text-muted-foreground/20">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              {% endif %}
            </a>

            {% comment %} Info — variant + qty under title, trash bottom-right {% endcomment %}
            <div class="flex-1 min-w-0 flex flex-col gap-3">

              {% comment %} Title + Unit price {% endcomment %}
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-medium text-sm text-foreground truncate pr-2">
                  <a href="{{ item.url }}" class="text-foreground no-underline hover:text-foreground/80 transition-colors">
                    {{ item.product.title }}
                  </a>
                </h3>
                <span class="text-sm font-medium text-foreground/80 whitespace-nowrap pt-px shrink-0">
                  {{ item.price | money }}
                </span>
              </div>

              {% comment %} Variant + Qty — directly under title {% endcomment %}
              <div class="flex items-center gap-3 flex-wrap">

                {% if item.product.variants.size > 1 %}
                <select class="variant-select"
                  data-item-key="{{ item.key }}"
                  data-quantity="{{ item.quantity }}">
                  {% for variant in item.product.variants %}
                  <option value="{{ variant.id }}"
                    {% if variant.id == item.variant.id %}selected{% endif %}>
                    {{ variant.title }}
                  </option>
                  {% endfor %}
                </select>
                {% else %}
                <span class="text-xs text-muted-foreground">{{ item.variant.title }}</span>
                {% endif %}

                {% comment %} Quantity — wider, cleaner {% endcomment %}
                <div class="flex items-center rounded-lg border border-border/50 bg-sand/15 overflow-hidden">
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                     class="w-[32px] h-[32px] flex items-center justify-center no-underline text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors {% if item.quantity <= 1 %}opacity-20 pointer-events-none{% endif %}"
                     aria-label="Diminuer la quantit&eacute;">&minus;</a>
                  <span class="w-[26px] text-center text-sm font-normal text-foreground select-none">{{ item.quantity }}</span>
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                     class="w-[32px] h-[32px] flex items-center justify-center no-underline text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
                     aria-label="Augmenter la quantit&eacute;">+</a>
                </div>

              </div>

              {% comment %} Remove — trash icon bottom-right {% endcomment %}
              <div class="flex justify-end mt-auto">
                <a href="/cart/change?line={{ forloop.index }}&quantity=0"
                   class="text-[#b91c1c]/40 hover:text-[#b91c1c] transition-colors no-underline leading-none p-1"
                   aria-label="Retirer du panier">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6"/><line x1="10" y1="11" x2="10" y2="16"/><line x1="14" y1="11" x2="14" y2="16"/>
                  </svg>
                </a>
              </div>

            </div>
          </div>
        </div>
        {% endfor %}

        {% comment %} ---------- Coupon Hint ---------- {% endcomment %}
        <p class="text-[11px] opacity-35 text-center mt-5 sm:mt-6 text-muted-foreground">
          Vous avez un code promo&nbsp;? Il s&rsquo;appliquera &agrave; l&rsquo;&eacute;tape suivante.
        </p>

        {% comment %} ---------- Divider ---------- {% endcomment %}
        <hr class="border-border/25 mt-5 sm:mt-6 mb-0">

        {% comment %} ---------- Total Breakdown — generous spacing ---------- {% endcomment %}
        <div class="flex flex-col gap-3 pt-6 sm:pt-7 pb-2">

          <div class="flex justify-between items-center">
            <span class="text-sm text-muted-foreground">Sous-total</span>
            <span class="text-sm text-foreground/75 font-medium">{{ cart.items_subtotal_price | money }}</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-sm text-muted-foreground">Livraison</span>
            <span class="text-sm font-medium" style="color:#059669;">Offerte</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-[12px] text-muted-foreground/45">TVA incluse</span>
            <span class="text-[12px] text-muted-foreground/30">{% assign tax_amount = cart.items_subtotal_price | times: 0.1667 %}{{ tax_amount | money }}</span>
          </div>

        </div>

        {% comment %} ---------- Divider ---------- {% endcomment %}
        <hr class="border-border/25 my-6 sm:my-7">

        {% comment %} ---------- Final Total ---------- {% endcomment %}
        <div class="flex justify-between items-center mb-7 sm:mb-8">
          <span class="text-sm font-medium text-foreground">Total</span>
          <span class="text-lg lg:text-xl font-medium text-foreground">{{ cart.total_price | money }}</span>
        </div>

        {% comment %} ---------- CTA ---------- {% endcomment %}
        <button type="submit" name="checkout" form="cart-form"
          class="w-full rounded-full bg-ember text-offwhite py-4 text-[15px] font-medium tracking-wide hover:bg-ember-soft transition-all border-0 cursor-pointer shadow-md">
          Commander &middot; {{ cart.total_price | money }}
        </button>

        {% comment %} ---------- Payment Methods — user's WEBP assets ---------- {% endcomment %}
        <div class="flex items-center justify-center gap-4 sm:gap-5 mt-6 flex-wrap">
          <img src="{{ 'Visa.webp' | asset_url }}" alt="Visa" width="36" height="24" loading="lazy">
          <img src="{{ 'Mastercard.webp' | asset_url }}" alt="Mastercard" width="36" height="24" loading="lazy">
          <img src="{{ 'Carte_Bancaire.webp' | asset_url }}" alt="CB" width="36" height="24" loading="lazy">
          <img src="{{ 'Apple_Pay.webp' | asset_url }}" alt="Apple Pay" width="36" height="24" loading="lazy">
          <img src="{{ 'Paypal.webp' | asset_url }}" alt="PayPal" width="36" height="24" loading="lazy">
          <img src="{{ 'Klarna.webp' | asset_url }}" alt="Klarna" width="36" height="24" loading="lazy">
        </div>

        {% comment %} ---------- Trust ---------- {% endcomment %}
        <p class="text-[10px] text-muted-foreground opacity-80 text-center mt-4 max-w-xs mx-auto leading-relaxed">
          Paiement 100% s&eacute;curis&eacute; &middot; Cryptage SSL &middot; 4&times; sans frais disponible
        </p>

      </div>

      {% comment %} ---------- Hidden Cart Form ---------- {% endcomment %}
      <form id="cart-form" method="post" action="/cart" class="hidden">
        {% for item in cart.items %}
          <input type="hidden" name="updates[]" value="{{ item.quantity }}">
        {% endfor %}
      </form>

      <div class="text-center mt-8">
        <a href="/" class="text-[13px] text-muted-foreground hover:text-foreground transition-colors no-underline">&larr; Continuer mes achats</a>
      </div>

    {% else %}

      <div class="text-center py-24">
        <h1 class="font-display text-4xl lg:text-6xl text-foreground mb-5">Votre panier est vide</h1>
        <p class="text-muted-foreground text-base mb-10">D&eacute;couvrez le rituel qui prend soin de vous.</p>
        <a href="/products/enora" class="inline-block rounded-full bg-foreground text-background px-10 py-4 text-sm tracking-wide hover:bg-foreground/90 transition-all no-underline font-medium">
          D&eacute;couvrir ENORA
        </a>
        <div class="mt-6">
          <a href="/#rituel" class="text-sm text-muted-foreground hover:text-foreground transition-colors no-underline">Le rituel &rarr;</a>
        </div>
      </div>

    {% endif %}

  </div>
</div>

{% comment %} ---------- Variant Select Styling ---------- {% endcomment %}
<style>
  .variant-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent;
    border: 1px solid oklch(0.88 0.018 70);
    border-radius: 0.5rem;
    padding: 0.35rem 1.75rem 0.35rem 0.65rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: oklch(0.22 0.008 60);
    cursor: pointer;
    width: auto;
    max-width: 150px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%239e8e7e' stroke-width='2'><path d='m6 9 6 6 6-6'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.4rem center;
    background-size: 10px 10px;
    transition: border-color 0.15s ease;
  }
  .variant-select:hover {
    border-color: oklch(0.62 0.028 55 / 0.5);
  }
  .variant-select:focus {
    outline: none;
    border-color: oklch(0.62 0.028 55);
    box-shadow: 0 0 0 1px oklch(0.62 0.028 55 / 0.12);
  }
</style>

{% comment %} ---------- Variant change: remove old + add new (Shopify ne permet pas de changer un variant in-place) ---------- {% endcomment %}
<script>
(function(){
  document.querySelectorAll('.variant-select').forEach(function(sel){
    sel.addEventListener('change', async function(){
      var newId = this.value;
      var key = this.dataset.itemKey;
      var qty = parseInt(this.dataset.quantity) || 1;
      if (!newId || !key) return;
      this.disabled = true;
      try {
        await fetch('/cart/change.js', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:key,quantity:0})});
        await fetch('/cart/add.js', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:parseInt(newId),quantity:qty}]})});
      } catch(e){}
      window.location.reload();
    });
  });
})();
</script>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
