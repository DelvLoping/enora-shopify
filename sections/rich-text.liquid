<div class="py-28 lg:py-40" data-section-type="rich-text" data-section-id="{{ section.id }}">
  <div class="mx-auto max-w-3xl px-6 lg:px-10">
    {% if section.settings.heading != blank %}
      <h1 class="font-display text-4xl lg:text-6xl text-foreground text-center mb-12">
        {{ section.settings.heading }}
      </h1>
    {% endif %}
    {% if section.settings.content != blank %}
      <div class="prose prose-lg text-muted-foreground leading-relaxed max-w-none">
        {{ section.settings.content }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "Rich Text",
      "category": "ENORA Sections"
    }
  ]
}
{% endschema %}
