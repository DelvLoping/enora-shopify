<section id="rituel" class="py-28 lg:py-40" style="background:oklch(0.96 0.015 78);" data-section-type="ritual" data-section-id="{{ section.id }}">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20 items-center">

    <div class="lg:col-span-5 lg:sticky lg:top-32">
      <p class="reveal text-[11px] tracking-[0.4em] uppercase text-taupe mb-6">
        {{ section.settings.eyebrow | escape }}
      </p>
      <h2 class="reveal reveal-delay-1 text-4xl lg:text-6xl text-balance">
        {{ section.settings.headline }}
      </h2>
      <p class="reveal reveal-delay-2 mt-8 text-muted-foreground text-balance leading-relaxed">
        {{ section.settings.description | escape }}
      </p>
    </div>

    <div class="lg:col-span-7 space-y-1">
      {% assign steps = section.settings.steps | split: '||' %}
      {% for step in steps %}
        {% assign parts = step | strip | split: '|' %}
        <div class="reveal reveal-delay-{{ forloop.index | minus: 1 }} group grid grid-cols-12 gap-6 py-8 border-b border-border last:border-0">
          <div class="col-span-2 text-[11px] tracking-[0.3em] text-taupe pt-1">
            {% if parts[0] %}{{ parts[0] | strip }}{% else %}0{{ forloop.index }}{% endif %}
          </div>
          <div class="col-span-10">
            <h3 class="text-2xl lg:text-3xl mb-3 transition-transform group-hover:translate-x-1">
              {% if parts[1] %}{{ parts[1] | strip }}{% endif %}
            </h3>
            <p class="text-muted-foreground max-w-md">
              {% if parts[2] %}{{ parts[2] | strip }}{% endif %}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Ritual Steps",
  "tag": "section",
  "class": "section-ritual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Le Rituel"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Quatre minutes pour vous, <em class='not-italic text-taupe'>chaque jour.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "textarea",
      "id": "steps",
      "label": "Steps (separated by ||, fields by |)",
      "default": "01|Calme|Une respiration. La lumière s'allume, le geste commence.||02|Soin|La lumière rouge réveille la microcirculation, en profondeur.||03|Rituel|Quatre minutes de présence, sans téléphone, sans bruit.||04|Éclat|Le cuir chevelu s'apaise. Les cheveux retrouvent leur force."
    }
  ],
  "presets": [
    {
      "name": "Ritual Steps",
      "category": "ENORA Sections"
    }
  ]
}
{% endschema %}
